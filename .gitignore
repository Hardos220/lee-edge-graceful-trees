# Whitelist: only the code and the data used in the paper are tracked.
/*
!/.gitignore
!/.zenodo.json
!/CITATION.cff
!/LICENSE
!/README.md
!/build.sh
!/src/
!/tests/
!/tools/
!/third_party/
!/runs/

/third_party/*
!/third_party/fetch_nauty.sh

/tools/*
!/tools/run_parts.py
!/tools/verify_part.py
!/tools/check_uniqueness.py
!/tools/py_recheck.py
!/tools/merge_recheck.py
!/tools/zr_analyze.py
!/tools/zr_counts.py
!/tools/make_paper_tables.py
!/tools/hardness_regression.py

/runs/*
!/runs/n*/
!/runs/zr_n*/
!/runs/checks/
/runs/checks/*
!/runs/checks/uniqueness.json
!/runs/checks/recheck.json
!/runs/checks/recheck_plan.json
!/runs/checks/zr_counts.json
!/runs/checks/hardness_regression.json

*.cert
# the certificates of the orders n <= 21 are deposited
!/runs/n[3-9]/parts/*.cert
!/runs/n1[0-9]/parts/*.cert
!/runs/n2[01]/parts/*.cert
*.log
*.top.txt
__pycache__/
